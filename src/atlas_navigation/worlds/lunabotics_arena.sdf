<?xml version="1.0"?>
<!-- Generated by tools/generate_arena.py.
2027 NASA guidebook sections 11.1-11.4: approx. 6.8 x 5 m clear interior;
.17 m ducts; rocks/craters randomized in competition. This is one fixed illustrative layout.
