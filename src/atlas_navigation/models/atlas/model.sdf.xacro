<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Edit assumptions HERE, then regenerate model.sdf (see ../../README.md).
       X forward, Y left, Z up; model/base_link at ground level.
       Navigation-test assumptions, NOT finalized ATLAS CAD. -->
  <xacro:property name="wheel_width" value="0.1143"/><!-- PNC update supplied 2026-11-05. -->
  <xacro:property name="wheel_radius" value="0.2159"/><!-- Historical 17 in diameter; SDR 3.3. -->
  <xacro:property name="track" value="0.62"/><!-- Estimated wheel center separation. -->
  <xacro:property name="wheelbase" value="0.82"/><!-- Estimated axle separation. -->
  <xacro:property name="chassis_length" value="0.92"/>
  <xacro:property name="chassis_width" value="0.48"/>
  <xacro:property name="chassis_height" value="0.26"/>
  <xacro:property name="ground_clearance" value="0.20"/>
  <xacro:property name="chassis_mass" value="47.0"/><!-- Includes unmodeled electronics/drivetrain. -->
  <xacro:property name="wheel_mass" value="2.0"/>
  <xacro:property name="arm_mass" value="2.0"/>
  <xacro:property name="drum_mass" value="1.5"/>
  <xacro:property name="arm_length" value="0.32"/>
  <xacro:property name="arm_width" value="0.06"/>
  <xacro:property name="arm_height" value="0.12"/>
  <xacro:property name="arm_x" value="0.50"/>
  <xacro:property name="arm_z" value="0.48"/>
  <xacro:property name="drum_x" value="0.61"/>
  <xacro:property name="drum_y" value="0.17"/>
  <xacro:property name="drum_z" value="0.56"/>
  <xacro:property name="drum_radius" value="0.12"/>
  <xacro:property name="drum_width" value="0.28"/>

  <!-- Unitree L2: origin at the bottom mounting center; +X forward (cable -X), +Z up.
       Default bottom height follows the chassis top, not a measured ATLAS extrinsic. -->
  <xacro:arg name="lidar_x" default="0.0"/>
  <xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="lidar_z" default="${ground_clearance + chassis_height}"/>
  <xacro:arg name="lidar_roll" default="0.0"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>
  <xacro:arg name="lidar_vertical_fov" default="96"/>
  <xacro:arg name="lidar_horizontal_samples" default="563"/>
  <xacro:arg name="lidar_vertical_samples" default="21"/>
  <xacro:arg name="lidar_max_range" default="30.0"/>
  <xacro:property name="lidar_min_angle"
    value="${[0.0, -6*pi/180][[90, 96].index(int('$(arg lidar_vertical_fov)'))]}"/>

  <xacro:macro name="inertia" params="mass ixx iyy izz z:=0">
    <inertial>
      <pose>0 0 ${z} 0 0 0</pose><mass>${mass}</mass>
      <inertia>
        <ixx>${ixx}</ixx><iyy>${iyy}</iyy><izz>${izz}</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
  </xacro:macro>
  <xacro:macro name="box_inertia" params="mass length width height z:=0">
    <xacro:inertia mass="${mass}" z="${z}"
      ixx="${mass * (width**2 + height**2) / 12}"
      iyy="${mass * (length**2 + height**2) / 12}"
      izz="${mass * (length**2 + width**2) / 12}"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="mass radius width">
    <!-- Cylinder axis is Y in the unrotated link frame. -->
    <xacro:inertia mass="${mass}"
      ixx="${mass * (3 * radius**2 + width**2) / 12}"
      iyy="${mass * radius**2 / 2}"
      izz="${mass * (3 * radius**2 + width**2) / 12}"/>
  </xacro:macro>
  <xacro:macro name="box_geometry" params="length width height">
    <geometry><box><size>${length} ${width} ${height}</size></box></geometry>
  </xacro:macro>
  <xacro:macro name="cylinder_geometry" params="radius width">
    <pose>0 0 0 ${pi / 2} 0 0</pose>
    <geometry><cylinder><radius>${radius}</radius><length>${width}</length></cylinder></geometry>
  </xacro:macro>
  <xacro:macro name="color" params="rgba">
    <material><ambient>${rgba}</ambient><diffuse>${rgba}</diffuse></material>
  </xacro:macro>

  <model name="atlas" canonical_link="base_link">
    <self_collide>false</self_collide>
    <link name="base_link">
      <xacro:box_inertia mass="${chassis_mass}" length="${chassis_length}"
        width="${chassis_width}" height="${chassis_height}"
        z="${ground_clearance + chassis_height / 2}"/>
      <collision name="chassis_collision">
        <pose>0 0 ${ground_clearance + chassis_height / 2} 0 0 0</pose>
        <xacro:box_geometry length="${chassis_length}" width="${chassis_width}" height="${chassis_height}"/>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 ${ground_clearance + chassis_height / 2} 0 0 0</pose>
        <xacro:box_geometry length="${chassis_length}" width="${chassis_width}" height="${chassis_height}"/>
        <xacro:color rgba="0.65 0.12 0.10 1"/>
      </visual>
    </link>

    <!-- Manufacturer dimensions/mass; uniform-box inertia is an approximation.
         Hide only the simplified opaque housing from its own virtual rays.
         Chassis, wheels, arms and drums remain visible to the LiDAR. -->
    <link name="unilidar_lidar">
      <pose>$(arg lidar_x) $(arg lidar_y) $(arg lidar_z) $(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)</pose>
      <xacro:box_inertia mass="${0.23}" length="${0.075}" width="${0.075}" height="${0.065}" z="${0.0325}"/>
      <collision name="lidar_housing_collision">
        <pose>0 0 0.0325 0 0 0</pose>
        <xacro:box_geometry length="${0.075}" width="${0.075}" height="${0.065}"/>
      </collision>
      <visual name="lidar_housing_visual">
        <pose>0 0 0.0325 0 0 0</pose>
        <xacro:box_geometry length="${0.075}" width="${0.075}" height="${0.065}"/>
        <visibility_flags>2</visibility_flags>
        <xacro:color rgba="0.15 0.15 0.18 1"/>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/model/atlas/lidar</topic><always_on>true</always_on><update_rate>5.55</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>$(arg lidar_horizontal_samples)</samples><resolution>1</resolution>
              <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>$(arg lidar_vertical_samples)</samples><resolution>1</resolution>
              <min_angle>${lidar_min_angle}</min_angle><max_angle>${pi/2}</max_angle>
            </vertical>
          </scan>
          <range><min>0.05</min><max>$(arg lidar_max_range)</max><resolution>0.0045</resolution></range>
          <visibility_mask>1</visibility_mask>
        </lidar>
      </sensor>
      <!-- SDK IMU origin relative to the bottom-center cloud frame; ideal IMU. -->
      <sensor name="imu" type="imu">
        <pose>-0.007698 -0.014655 0.00667 0 0 0</pose>
        <topic>/model/atlas/imu</topic><always_on>true</always_on><update_rate>500</update_rate>
      </sensor>
    </link>
    <joint name="unilidar_mount" type="fixed">
      <parent>base_link</parent><child>unilidar_lidar</child>
    </joint>

    <xacro:macro name="wheel" params="end side x y">
      <link name="${end}_${side}_wheel">
        <pose>${x} ${y} ${wheel_radius} 0 0 0</pose>
        <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
        <collision name="wheel_collision">
          <xacro:cylinder_geometry radius="${wheel_radius}" width="${wheel_width}"/>
          <surface>
            <friction><ode>
              <!-- Collision-local Z is the axle: allow lateral scrub during turns.
                   Solver tuning, NOT measured regolith properties. -->
              <fdir1>0 0 1</fdir1><mu>0.2</mu><mu2>1.0</mu2>
              <slip1>0.01</slip1><slip2>0</slip2>
            </ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
            <contact><ode><kp>1000000</kp><kd>100</kd>
              <max_vel>0.1</max_vel><min_depth>0.001</min_depth>
            </ode></contact>
          </surface>
        </collision>
        <visual name="wheel_visual">
          <xacro:cylinder_geometry radius="${wheel_radius}" width="${wheel_width}"/>
          <xacro:color rgba="0.22 0.24 0.26 1"/>
        </visual>
      </link>
      <joint name="${end}_${side}_wheel_joint" type="revolute">
        <parent>base_link</parent><child>${end}_${side}_wheel</child>
        <axis><xyz>0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper>
            <effort>30</effort><velocity>8</velocity>
          </limit>
          <dynamics><damping>0.05</damping></dynamics>
        </axis>
      </joint>
    </xacro:macro>
    <xacro:wheel end="front" side="left" x="${wheelbase / 2}" y="${track / 2}"/>
    <xacro:wheel end="rear" side="left" x="${-wheelbase / 2}" y="${track / 2}"/>
    <xacro:wheel end="front" side="right" x="${wheelbase / 2}" y="${-track / 2}"/>
    <xacro:wheel end="rear" side="right" x="${-wheelbase / 2}" y="${-track / 2}"/>

    <!-- Raised transport envelope: no excavation actuation or soil interaction.
         Two arms, each with two plain cylindrical drum placeholders. -->
    <xacro:macro name="drum" params="end side sign y">
      <link name="${end}_${side}_drum">
        <pose>${sign * drum_x} ${y} ${drum_z} 0 0 0</pose>
        <xacro:cylinder_inertia mass="${drum_mass}" radius="${drum_radius}" width="${drum_width}"/>
        <collision name="drum_collision">
          <xacro:cylinder_geometry radius="${drum_radius}" width="${drum_width}"/>
        </collision>
        <visual name="drum_visual">
          <xacro:cylinder_geometry radius="${drum_radius}" width="${drum_width}"/>
          <xacro:color rgba="0.75 0.55 0.12 1"/>
        </visual>
      </link>
      <joint name="${end}_${side}_drum_mount" type="fixed">
        <parent>${end}_arm</parent><child>${end}_${side}_drum</child>
      </joint>
    </xacro:macro>
    <xacro:macro name="excavator" params="end sign">
      <link name="${end}_arm">
        <pose>${sign * arm_x} 0 ${arm_z} 0 0 0</pose>
        <xacro:box_inertia mass="${arm_mass}" length="${arm_length}" width="${arm_width}" height="${arm_height}"/>
        <collision name="arm_collision">
          <xacro:box_geometry length="${arm_length}" width="${arm_width}" height="${arm_height}"/>
        </collision>
        <visual name="arm_visual">
          <xacro:box_geometry length="${arm_length}" width="${arm_width}" height="${arm_height}"/>
          <xacro:color rgba="0.45 0.45 0.48 1"/>
        </visual>
      </link>
      <joint name="${end}_arm_mount" type="fixed">
        <parent>base_link</parent><child>${end}_arm</child>
      </joint>
      <xacro:drum end="${end}" side="left" sign="${sign}" y="${drum_y}"/>
      <xacro:drum end="${end}" side="right" sign="${sign}" y="${-drum_y}"/>
    </xacro:macro>
    <xacro:excavator end="front" sign="${1}"/>
    <xacro:excavator end="rear" sign="${-1}"/>

    <!-- Idealized side-speed control; does not select motor/gearbox topology. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/atlas/cmd_vel</topic><odom_topic>/model/atlas/odometry</odom_topic>
      <tf_topic>/model/atlas/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_linear_velocity>-0.5</min_linear_velocity><max_linear_velocity>0.5</max_linear_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity><max_angular_velocity>0.8</max_angular_velocity>
      <min_linear_acceleration>-0.5</min_linear_acceleration><max_linear_acceleration>0.5</max_linear_acceleration>
      <min_angular_acceleration>-0.8</min_angular_acceleration><max_angular_acceleration>0.8</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/atlas/joint_state</topic>
      <joint_name>front_left_wheel_joint</joint_name><joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name><joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
